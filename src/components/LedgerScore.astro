---
/**
 * BANDE DE SCORE — le hook de la home.
 *
 * Le total et les compteurs sont dérivés de computeLedger() : aucun nombre
 * n'est écrit en dur, donc le score ne peut pas contredire le carnet.
 */
import type { Lang } from '../i18n/utils';
import { getData } from '../i18n/utils';
import { computeLedger } from '../utils/ledger';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const data = getData(lang);
const ui = data.ui.ledger;
const ledger = computeLedger(data);
const headline = ui.headline.replaceAll('{count}', String(ledger.total));
---

<section aria-label={ui.eyebrow} class="px-6 pb-6">
  <div class="max-w-7xl mx-auto scroll-reveal">
    <div class="tile p-8">
      <span class="mono-label mb-6 block">{ui.eyebrow}</span>
      <p class="font-display text-heading font-bold text-zinc-900 dark:text-zinc-50 mb-4">
        {headline}
      </p>
      <p class="text-sm text-zinc-500 dark:text-zinc-400 max-w-2xl leading-relaxed mb-8">
        {ui.thesis}
      </p>
      <div class="flex flex-wrap gap-px bg-zinc-200 dark:bg-zinc-800">
        {
          ledger.counts.map((entry) => (
            <div class="tile p-4 flex-1 basis-32">
              <p class="font-display text-2xl font-bold text-zinc-900 dark:text-zinc-50">
                {entry.count}
              </p>
              <p class="mono-label mt-1 block">
                {entry.count === 1
                  ? ui.statusCounts[entry.status].one
                  : ui.statusCounts[entry.status].other}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
