---
import { getLocalizedPath, getOppositeLang, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
  label: string;
  /**
   * Destination explicite, prioritaire sur le calcul automatique.
   * Utile quand le chemin ne suffit pas à déduire l'équivalent (ex. articles
   * de blog dont le slug diffère entre FR et EN). Non fournie : comportement
   * inchangé (chemin déduit via getLocalizedPath).
   */
  destination?: string;
}

const { lang, label, destination } = Astro.props;
const targetLang = getOppositeLang(lang);
const targetPath = destination ?? getLocalizedPath(Astro.url.pathname, targetLang);
---

<a
  href={targetPath}
  aria-label={label}
  class="font-mono text-xs uppercase tracking-wider text-zinc-500 dark:text-zinc-400 hover:text-accent-500 transition-colors duration-200 inline-flex items-center justify-center min-w-[24px] min-h-[24px] py-2 px-2"
>
  {targetLang.toUpperCase()}
</a>
